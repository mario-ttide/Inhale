work/
gen/
image/
exefs/
romfs/
*.bin
*.keys
*.nso
*.nca
*.nsp
*.xci
gamefile/
*.nup
*.nsz
*.xcz
*.sav
# (this game's data formats: compressed archives, movies, shader, sound and stream files)
*.cmp
*.cmpbin
*.webm
*.bfsha
*.bfsar
*.bfstm

# ---- build output and caches ----
build/
/third_party_objects/
__pycache__/
*.pyc
*.o
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.sha1
*.log

# ---- Linux builds ----
build-linux/
*.so

# ---- a checkout's own development builds on Windows (scripts/dev.py) ----
build-windows/

# ---- NVIDIA's DLSS SDK (scripts/fetch.py dlss): NVIDIA's files, never committed ----
ngx-sdk/
test-results/
_deps/

# ---- a link to <build>/compile_commands.json (nx2/build.py write_compdb), for clangd and clang-tidy ----
/compile_commands.json

# ---- the Python environment of the tools ----
.venv/

# ---- Visual Studio IDE files ----
.vs/
.vscode/
CppProperties.json

# .NET build output
**/obj/
